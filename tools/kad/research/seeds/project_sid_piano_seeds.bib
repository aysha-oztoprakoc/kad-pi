% BibTeX seeds for Project Sid (Altera.AL) / PIANO Architecture and Emergent Multi-Agent Civilizations
% Intended for Elicit Free Tier extraction and KAD-PI / Gaya RPG integration

@article{Yang2024ProjectSidMany,
  title = {Project Sid: Many-Agent Simulations Toward AI Civilization},
  author = {Robert Yang and Gabriel C. Huang and Jenny Jiang and Michael Zhang and Altera.AL Research Team},
  year = {2024},
  journal = {arXiv preprint},
  doi = {10.48550/arxiv.2411.00114},
  url = {https://arxiv.org/abs/2411.00114},
  eprint = {2411.00114},
  archivePrefix = {arXiv},
  primaryClass = {cs.AI},
  abstract = {Project Sid is a large-scale AI research initiative demonstrating simulations of 1,000+ autonomous AI agents interacting within an open-ended virtual sandbox. Agents operate via the PIANO architecture (Parallel Information Aggregation via Neural Orchestration), which runs concurrent cognitive modules (memory, proprioception, social awareness, action awareness, and planning) coordinated through a central cognitive controller. The simulation observes emergent civilizational phenomena including specialized division of labor, open-market trade with emergent currency, collective democratic governance and legal rules, and the spontaneous transmission of religious and philosophical memes.}
}

@article{Park2023GenerativeAgents,
  title = {Generative Agents: Interactive Simulacra of Human Behavior},
  author = {Joon Sung Park and Joseph C. O'Brien and Carrie Jun Cai and Meredith Ringel Morris and Percy Liang and Michael S. Bernstein},
  year = {2023},
  journal = {The 36th Annual ACM Symposium on User Interface Software and Technology (UIST '23)},
  doi = {10.1145/3586183.3606763},
  url = {https://arxiv.org/abs/2304.03442},
  abstract = {Believable proxies of human behavior can empower interactive applications ranging from immersive environments to social policy rehearsal. We introduce generative agents computational software agents that simulate believable human behavior. Generative agents wake up, cook breakfast, head to work, form opinions, notice each other, and initiate conversations. We instantiate generative agents in an interactive sandbox environment inspired by The Sims, where end users can interact with a small town of twenty-five agents using natural language.}
}

@article{Wang2023Voyager,
  title = {Voyager: An Open-Ended Embodied Agent with Large Language Models},
  author = {Guanzhi Wang and Yuqi Xie and Yunfan Jiang and Ajay Mandlekar and Chaowei Xiao and Yuke Zhu and Linxi Fan and Anima Anandkumar},
  year = {2023},
  journal = {arXiv preprint},
  doi = {10.48550/arxiv.2305.16291},
  url = {https://arxiv.org/abs/2305.16291},
  abstract = {Voyager is the first LLM-powered embodied lifelong learning agent in Minecraft that continuously explores the world, acquires diverse skills, and makes novel discoveries without human intervention. Voyager consists of three key components: an automatic curriculum that maximizes exploration, an iterative prompting mechanism that generates executable code for embodied actions, and a skill library for storing and retrieving complex behaviors.}
}

@article{Barreto2021TheOptionKeyboa,
  title = {The Option Keyboard: Combining Skills in Reinforcement Learning},
  author = {Andr{\'e} Barreto and Shaobo Hou and Diana Borsa and David Silver and Doina Precup},
  year = {2021},
  journal = {Advances in Neural Information Processing Systems (NeurIPS 2019)},
  doi = {10.13140/rg.2.2.12370.50882},
  url = {https://arxiv.org/abs/2106.13105},
  abstract = {Temporal abstraction in reinforcement learning is often formalized via options. We show how successor features and generalized policy improvement allow agents to combine previously learned options to instantly solve new tasks without additional training, forming an Option Keyboard for compositional agent behavior.}
}
