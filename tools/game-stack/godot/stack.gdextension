[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://libstack_extension.so"
linux.release.x86_64 = "res://libstack_extension.so"
windows.debug.x86_64 = "res://stack_extension.dll"
windows.release.x86_64 = "res://stack_extension.dll"
web.debug.wasm32 = "res://stack_extension.wasm"
web.release.wasm32 = "res://stack_extension.wasm"
