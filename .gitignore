# Installer backups (e.g. AGENTS.md.bak-<epoch> emitted by tooling that edits AGENTS.md in place)
*.bak-*

# Vendored third-party checkouts, downloaded toolchains and build output.
# Each of these has its own upstream (and its own .git); none is KAD-PI source.
# ACE-Step/                      - upstream audio-model checkout (19G)
# tools/game-stack/emsdk/        - Emscripten SDK (1.7G, own .git)
# tools/game-stack/godot-source/ - Godot engine source (1.4G, own .git)
# tools/game-stack/target/       - Rust build output (2.6G)
# tools/game-stack/exports/      - exported game builds (317M)
ACE-Step/
tools/game-stack/emsdk/
tools/game-stack/godot-source/
tools/game-stack/target/
tools/game-stack/exports/

# Godot editor cache and compiled GDExtension binaries
tools/game-stack/godot/.godot/
tools/game-stack/godot/bin/

