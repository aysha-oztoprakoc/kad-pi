#!/usr/bin/env bash
# kad-serve: Manage KAD local model inference backends on Vulkan GPU
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
KOBOLD_BIN="$WORK_ROOT/kad-sillytavern/koboldcpp/koboldcpp-linux-x64-nocuda"
PID_DIR="$WORK_ROOT/.state/omp-kad/run"
mkdir -p "$PID_DIR" "$WORK_ROOT/kad-sillytavern/logs"

usage() {
  echo "Usage: kad-serve <stheno|rp-hero|lumimaid|qwen|load <id|path>|status|list|stop>"
  echo "  stheno     - Launch Stheno v3.2 on 127.0.0.1:5001 (Vulkan, 16k ctx, Llama-3)"
  echo "  rp-hero    - Launch RP-Hero 8B on 127.0.0.1:5001 (Vulkan, 16k ctx, Llama-3.1)"
  echo "  lumimaid   - Launch Lumimaid 8B on 127.0.0.1:5001 (Vulkan, 16k ctx, Llama-3)"
  echo "  qwen [port]- Launch Qwen 3.5 9B on 127.0.0.1:5001 (or specified port, Vulkan, 16k ctx)"
  echo "  load <id>  - Launch any local model by id/path on 127.0.0.1:5001"
  echo "  status     - Report status of local inference ports (5001, 5002)"
  echo "  list       - List available local models"
  echo "  stop       - Stop all local inference processes"
  exit 1
}

check_port() {
  local port="$1"
  curl -s --connect-timeout 1 "http://127.0.0.1:${port}/v1/models" 2>/dev/null || true
}

stop_all() {
  echo "Stopping local inference processes..."
  systemctl --user stop kad-kobold-5001 kad-kobold-5002 kad-kobold-stheno kad-kobold-qwen 2>/dev/null || true
  # Kill by pattern if running
  pkill -f "koboldcpp-linux-x64-nocuda" 2>/dev/null || true
  sleep 1
  echo "Local inference processes stopped."
}

resolve_model_path() {
  local target="$1"
  if [[ -f "$target" ]]; then
    echo "$target"
    return 0
  fi
  local from_kad
  from_kad=$("$WORK_ROOT/bin/kad-model" path "$target" 2>/dev/null || true)
  if [[ -n "$from_kad" && -f "$from_kad" ]]; then
    echo "$from_kad"
    return 0
  fi
  case "$target" in
    stheno|stheno-v3.2)
      echo "$WORK_ROOT/.models/gguf/world/L3-8B-Stheno-v3.2-Q4_K_M.gguf"
      ;;
    rp-hero|rp-hero-8b)
      echo "$WORK_ROOT/.models/gguf/world/L3.1-RP-Hero-InBetween-8B-D_AU-Q4_k_m.gguf"
      ;;
    lumimaid|lumimaid-8b)
      echo "$WORK_ROOT/.models/gguf/world/Llama-3-Lumimaid-8B-v0.1-OAS-Q4_K_M-imat.gguf"
      ;;
    qwen|qwen-local)
      echo "$WORK_ROOT/.models/gguf/retrieval/Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf"
      ;;
    lunaris|lunaris-8b)
      echo "$WORK_ROOT/.models/gguf/world/L3-8B-Lunaris-v1-Q4_K_M.gguf"
      ;;
    dolphin|dolphin-8b)
      echo "$WORK_ROOT/.models/gguf/world/Dolphin3.0-Llama3.1-8B-Q4_K_M.gguf"
      ;;
    neural-daredevil|neural-daredevil-8b)
      echo "$WORK_ROOT/.models/gguf/world/NeuralDaredevil-8B-abliterated-Q4_K_M.gguf"
      ;;
    hermes3|hermes-3-8b)
      echo "$WORK_ROOT/.models/gguf/world/Hermes-3-Llama-3.1-8B.Q4_K_M.gguf"
      ;;
    openhermes|openhermes-7b)
      echo "$WORK_ROOT/.models/gguf/world/openhermes-2.5-mistral-7b.Q4_K_M.gguf"
      ;;
    llama-abliterated|llama-3.1-abliterated)
      echo "$WORK_ROOT/.models/gguf/world/Meta-Llama-3.1-8B-Instruct-abliterated-Q4_K_M.gguf"
      ;;
    dark-planet|dark-planet-8b)
      echo "$WORK_ROOT/.models/gguf/world/Llama-3.1-128k-Dark-Planet-Uncensored-8B-Q4_k_m.gguf"
      ;;
    chaos-rp|chaos-rp-8b)
      echo "$WORK_ROOT/.models/gguf/world/Chaos_RP_l3_8B-Q4_K_M-imat.gguf"
      ;;
    gemma|gemma-e4b)
      echo "$WORK_ROOT/.models/gguf/world/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf"
      ;;
    rocinante|rocinante-12b)
      echo "$WORK_ROOT/.models/gguf/world/Rocinante-12B-v1.1-Q4_K_M.gguf"
      ;;
    violet-lotus|violet-lotus-12b)
      echo "$WORK_ROOT/.models/gguf/world/MN-Violet-Lotus-12B.Q4_K_M.gguf"
      ;;
    *)
      echo ""
      ;;
  esac
}

launch_model() {
  local model_alias="$1"
  local model_path="$2"
  local port="${3:-5001}"
  local unit_name="kad-kobold-${port}"
  local log_file="$WORK_ROOT/kad-sillytavern/logs/kobold-${port}.log"

  if [[ -z "$model_path" || ! -f "$model_path" ]]; then
    echo "Error: model file not found for '$model_alias' (path: $model_path)" >&2
    return 1
  fi

  local current
  current=$(check_port "$port")
  if [[ -n "$current" && "$current" == *"$model_alias"* ]]; then
    echo "$model_alias is already running on http://127.0.0.1:${port}/v1"
    return 0
  fi

  local sd_args=()
  local chosen_sd="${KAD_SD_MODEL:-sdxs}"
  local resolved_sd=""
  if [[ "$chosen_sd" == "dreamshaper" || "$chosen_sd" == "dreamshaper-xl" || "$chosen_sd" == "sdxl" ]]; then
    resolved_sd="$WORK_ROOT/.models/gguf/image/dreamshaperXL_v2_q4_k.gguf"
  elif [[ "$chosen_sd" == "sdxs" || "$chosen_sd" == "sdxs-image" ]]; then
    resolved_sd="$WORK_ROOT/.models/gguf/image/sdxs-512-tinySDdistilled_Q8_0.gguf"
  elif [[ -f "$chosen_sd" ]]; then
    resolved_sd="$chosen_sd"
  else
    resolved_sd="$WORK_ROOT/.models/gguf/image/sdxs-512-tinySDdistilled_Q8_0.gguf"
  fi

  if [[ -n "$resolved_sd" && -f "$resolved_sd" ]]; then
    sd_args+=(--sdmodel "$resolved_sd" --sdoffloadcpu --sdvaeauto)
  fi

  echo "Starting $model_alias on port $port (16k context, q8_0 KV cache, Vulkan device 0, image gen enabled)..."
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user status >/dev/null 2>&1; then
    systemd-run --user --unit="$unit_name" \
      "$KOBOLD_BIN" \
      --model "$model_path" \
      --usevulkan 0 --gpulayers -1 --autofit \
      --contextsize 16384 --quantkv q8_0 --batchsize 512 \
      "${sd_args[@]}" \
      --host 127.0.0.1 --port "$port" --skiplauncher \
      > "$log_file" 2>&1
  else
    nohup "$KOBOLD_BIN" \
      --model "$model_path" \
      --usevulkan 0 --gpulayers -1 --autofit \
      --contextsize 16384 --quantkv q8_0 --batchsize 512 \
      "${sd_args[@]}" \
      --host 127.0.0.1 --port "$port" --skiplauncher \
      < /dev/null > "$log_file" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_DIR/kobold-${port}.pid"
  fi

  # Wait for readiness
  local waited=0
  while [[ $waited -lt 35 ]]; do
    current=$(check_port "$port")
    if [[ -n "$current" && "$current" != "null" ]]; then
      echo "Model $model_alias is ready at http://127.0.0.1:${port}/api (OpenAI: http://127.0.0.1:${port}/v1)"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "Timed out waiting for model to become ready on port $port. Check log: $log_file"
  return 1
}

cmd="${1:-status}"
case "$cmd" in
  stheno|stheno-v3.2)
    launch_model "Stheno-v3.2" "$(resolve_model_path stheno)" 5001
    ;;
  rp-hero|rp-hero-8b)
    launch_model "RP-Hero-8B" "$(resolve_model_path rp-hero)" 5001
    ;;
  lumimaid|lumimaid-8b)
    launch_model "Lumimaid-8B" "$(resolve_model_path lumimaid)" 5001
    ;;
  qwen|qwen-local)
    port="${2:-5001}"
    launch_model "Qwen-3.5" "$(resolve_model_path qwen)" "$port"
    ;;
  lunaris|dolphin|neural-daredevil|hermes3|openhermes|llama-abliterated|dark-planet|chaos-rp|gemma|gemma-e4b|rocinante|violet-lotus)
    port="${2:-5001}"
    launch_model "$1" "$(resolve_model_path "$1")" "$port"
    ;;
  load)
    target="${2:-}"
    if [[ -z "$target" ]]; then
      echo "Usage: kad-serve load <model-id|path> [port]"
      exit 1
    fi
    port="${3:-5001}"
    launch_model "$target" "$(resolve_model_path "$target")" "$port"
    ;;
  list)
    echo "=== Available Local Models ==="
    "$WORK_ROOT/bin/kad-model" list
    ;;
  stop)
    stop_all
    ;;
  status)
    echo "=== Local Inference Status ==="
    stheno_status=$(check_port 5001)
    if [[ -n "$stheno_status" ]]; then
      echo "Port 5001: ONLINE - $stheno_status"
    else
      echo "Port 5001: OFFLINE"
    fi
    qwen_status=$(check_port 5002)
    if [[ -n "$qwen_status" ]]; then
      echo "Port 5002: ONLINE - $qwen_status"
    else
      echo "Port 5002: OFFLINE"
    fi
    ;;
  *)
    usage
    ;;
esac
