#!/usr/bin/env node
import {
  executeKadCommand,
  executeKadDoctor,
  renderDetailedPanel,
} from '../tools/kad/telemetry/control-plane-runtime.mjs';
import {
  ShadowObservatoryJournal,
  evaluateJournalReadiness
} from '../tools/kad/telemetry/observatory.mjs';

const args = process.argv.slice(2);
const isJson = args.includes('--json') || args.includes('-j');
const filteredArgs = args.filter((a) => a !== '--json' && a !== '-j');
const subcommand = filteredArgs[0] || 'status';

async function main() {
  if (subcommand === 'doctor') {
    const result = await executeKadDoctor();
    if (isJson) {
      process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    } else {
      process.stdout.write(`KAD DOCTOR: ${result.verdict}\n\n`);
      for (const check of result.checks) {
        const icon = check.status === 'PASS' ? '✓' : check.status === 'DEGRADED' ? '!' : '✗';
        process.stdout.write(`  [${icon}] ${check.name.padEnd(24)} ${check.message}\n`);
      }
      process.stdout.write('\n');
    }
    process.exitCode = result.verdict === 'FAIL' ? 1 : 0;
    return;
  }

  if (subcommand === 'help' || subcommand === '--help' || subcommand === '-h') {
    process.stdout.write(`KAD Operator Control Plane CLI

Usage:
  kad status [--json]      Show current normalized control plane status
  kad doctor [--json]      Run comprehensive doctor diagnostic checks
  kad tokens [--json]      Show token and quota usage
  kad providers [--json]   List discovered providers and telemetry state
  kad budget [--json]      Show economic router and budget authorization
  kad observatory [--json]           Show longitudinal actual vs shadow divergence metrics
  kad observatory readiness [--json] Show deterministic promotion readiness gate status
  kad readiness [--json]             Alias for observatory readiness
  kad services [--json]              Show service health (OpenViking, Zotero, etc.)
  kad work [--json]                  Show workctl active claim and frontier
  kad ui                             Render the full native panel in terminal
\n`);
    return;
  }
  if ((subcommand === 'observatory' && filteredArgs[1] === 'readiness') || subcommand === 'readiness') {
    const journal = new ShadowObservatoryJournal();
    const readiness = evaluateJournalReadiness(journal);

    if (isJson) {
      process.stdout.write(`${JSON.stringify(readiness, null, 2)}\n`);
      return;
    }

    process.stdout.write(`KAD PROMOTION READINESS GATE\n\n`);
    process.stdout.write(`  Global Status:      ${readiness.global_readiness.status}\n`);
    process.stdout.write(`  Reason Codes:       ${readiness.global_readiness.reason_codes.join(', ')}\n`);
    process.stdout.write(`  Observations:       ${readiness.global_readiness.metrics.total_observations} examined (comparable: ${readiness.global_readiness.metrics.comparable_observations})\n`);
    process.stdout.write(`  Divergence Rate:    ${(readiness.global_readiness.metrics.divergence_rate * 100).toFixed(1)}% (${readiness.global_readiness.metrics.divergence_count} divergences)\n\n`);
    process.stdout.write(`GATES:\n`);
    process.stdout.write(`  Integrity Gate:     ${readiness.integrity_gate.passed ? 'PASS ✓' : 'FAIL ✗'}\n`);
    process.stdout.write(`  Policy Drift Gate:  ${readiness.policy_drift_gate.passed ? 'PASS ✓' : 'DRIFT DETECTED !'}\n`);
    process.stdout.write(`  Quality Gate:       ${readiness.quality_gate.passed ? 'PASS ✓' : 'UNKNOWN-DOMINATED !'} (unknown rate: ${(readiness.quality_gate.unknown_rate * 100).toFixed(1)}%)\n\n`);
    process.stdout.write(`ADVISORY CLASS READINESS:\n`);
    for (const [cls, stat] of Object.entries(readiness.advisory_class_readiness || {})) {
      const badge = stat.ready_for_canary_design ? '[READY FOR CANARY DESIGN]' : '[INSUFFICIENT DATA]';
      process.stdout.write(`  ${cls.padEnd(36)} ${badge}  (occurrences: ${stat.occurrences}, divergences: ${stat.divergences})\n`);
    }
    process.stdout.write(`\nAUTHORITY CONTRACT:\n`);
    process.stdout.write(`  Canary Authorized:  NO (readiness evaluation only)\n`);
    process.stdout.write(`  Routing Mutation:   NO (production router immutable)\n`);
    process.stdout.write(`  Empirical Savings:  UNKNOWN (no causal claims without intervention)\n`);
    return;
  }

  const vm = await executeKadCommand(subcommand);

  if (isJson) {
    process.stdout.write(`${JSON.stringify(vm, null, 2)}\n`);
    return;
  }
  if (subcommand === 'ui' || subcommand === 'status') {
    process.stdout.write(`${renderDetailedPanel(vm)}\n`);
    return;
  }

  if (subcommand === 'tokens') {
    process.stdout.write(`KAD TOKENS & QUOTAS\n`);
    process.stdout.write(`Session tokens: ${vm.overview?.session_tokens ?? 0}\n\n`);
    for (const p of vm.providers || []) {
      process.stdout.write(`  ${p.provider_id.padEnd(24)} ${p.quota_display} [${p.source_class || p.state || 'UNKNOWN'}]\n`);
    }
    return;
  }

  if (subcommand === 'providers') {
    process.stdout.write(`KAD PROVIDERS INVENTORY\n\n`);
    for (const p of vm.providers || []) {
      process.stdout.write(`  ${p.provider_id.padEnd(24)} status: ${p.status || 'UNKNOWN'}  source: ${p.source_class || p.state || 'UNKNOWN'}\n`);
      if (p.models?.length) {
        process.stdout.write(`    models: ${p.models.join(', ')}\n`);
      }
    }
    return;
  }

  if (subcommand === 'budget') {
    process.stdout.write(`KAD ECONOMIC ROUTER & BUDGET\n\n`);
    process.stdout.write(`  Production Route: ${vm.overview?.economic_route || 'DEFAULT'} (${vm.overview?.execution_class || 'UNKNOWN'})\n`);
    process.stdout.write(`  Paid authorized:  ${vm.overview?.paid_authorized ? 'YES' : 'NO (FREE/SUBSCRIPTION ONLY)'}\n`);
    process.stdout.write(`  Route status:     ${vm.overview?.route_status || 'UNKNOWN'}\n\n`);
    process.stdout.write(`SHADOW ECONOMIC EVALUATION [ADVISORY ONLY]:\n`);
    const eco = vm.economic || {};
    const shadow = eco.shadow || {};
    const status = vm.overview?.shadow_same_or_different === 'SAME' ? '[SAME AS PRODUCTION]' : '[DIVERGENT ADVICE]';
    process.stdout.write(`  Shadow Route:     ${vm.overview?.shadow_route || 'DEFAULT'} (${vm.overview?.shadow_class || 'UNKNOWN'}) ${status}\n`);
    if (shadow.reason_codes?.length) {
      process.stdout.write(`  Reason codes:     ${shadow.reason_codes.join(', ')}\n`);
    }
    process.stdout.write(`  Telemetry state:  freshness=${shadow.telemetry_freshness || 'UNKNOWN'}, epistemic=${shadow.epistemic_quality || 'UNKNOWN'}\n`);
    return;
  }

  if (subcommand === 'services') {
    process.stdout.write(`KAD SERVICES HEALTH\n\n`);
    for (const [srv, state] of Object.entries(vm.services || {})) {
      process.stdout.write(`  ${srv.padEnd(20)} ${state.state} ${state.reason ? `(${state.reason})` : ''}\n`);
    }
    return;
  }

  if (subcommand === 'work') {
    process.stdout.write(`KAD WORKCTL STATE\n\n`);
    const w = vm.workctl || {};
    if (w.has_active_claim) {
      process.stdout.write(`  Active Claim: ${w.ticket_id} (actor: ${w.actor_label})\n`);
    } else {
      process.stdout.write(`  NO ACTIVE CLAIM\n`);
    }
    if (w.frontier?.length) process.stdout.write(`  Frontier: ${w.frontier.join(', ')}\n`);
    return;
  }
  if (subcommand === 'observatory') {
    const obs = vm.observatory || {};
    process.stdout.write(`KAD COUNTERFACTUAL OBSERVATORY\n\n`);
    process.stdout.write(`  Total observations:    ${obs.total_observations ?? 0}\n`);
    process.stdout.write(`  Comparable:            ${obs.comparable_observations ?? 0}\n`);
    process.stdout.write(`  Agreement count:       ${obs.agreement_count ?? 0}\n`);
    process.stdout.write(`  Divergence count:      ${obs.divergence_count ?? 0} (rate: ${((obs.divergence_rate ?? 0) * 100).toFixed(1)}%)\n\n`);
    process.stdout.write(`OPPORTUNITY CLASSES (COUNTERFACTUAL ESTIMATES):\n`);
    const opp = obs.opportunity_counts || {};
    for (const [key, count] of Object.entries(opp)) {
      process.stdout.write(`  ${key.padEnd(36)} ${count}\n`);
    }
    process.stdout.write(`\nACTUAL TOKENS OBSERVED:\n`);
    const tok = obs.actual_tokens || {};
    process.stdout.write(`  Input: ${tok.input_tokens ?? 0}  Output: ${tok.output_tokens ?? 0}  Cache: ${tok.cached_input_tokens ?? 0}  Total: ${tok.total_tokens ?? 0}\n`);
    process.stdout.write(`\nJOURNAL INTEGRITY:\n`);
    const integrity = obs.integrity || {};
    process.stdout.write(`  Valid: ${integrity.valid ? 'YES' : 'NO'}  Records: ${integrity.record_count ?? 0}\n`);
    return;
  }

  // Default fallback
  process.stdout.write(`${renderDetailedPanel(vm)}\n`);
}

main().catch((err) => {
  process.stderr.write(`kad error: ${err.message}\n`);
  process.exitCode = 1;
});
