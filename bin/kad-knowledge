#!/usr/bin/env node
import { runCuratedKnowledgeCli } from '../tools/kad/wiki-projection.mjs';
import { runResearchCli } from '../tools/kad/research-cli.mjs';

const args = process.argv.slice(2);
if (args[0] === 'research') {
  process.exitCode = await runResearchCli(args.slice(1));
} else {
  process.exitCode = runCuratedKnowledgeCli(args);
}
