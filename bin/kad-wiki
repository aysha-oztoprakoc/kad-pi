#!/usr/bin/env node
import path from 'node:path';
import { ensureVault, lintVault, ingestSource, propose, approve, applyProposal, query, rebuild, buildContextPack, vaultRoot } from '../tools/kad/wiki/index.mjs';
import { migrationManifest } from '../tools/kad/wiki/migration.mjs';
const args=process.argv.slice(2), cmd=args[0]||'status', root=vaultRoot();
const json=args.includes('--json'); const val=(name)=>{const i=args.indexOf(name); return i>=0?args[i+1]:undefined;};
function out(x){process.stdout.write(json?JSON.stringify(x,null,2)+'\n':typeof x==='string'?x+'\n':JSON.stringify(x,null,2)+'\n');}
try { ensureVault(root);
 if(cmd==='status'){out({vault:root,lint:lintVault(root),canonical_revision:(await import('../tools/kad/wiki/index.mjs')).revision(root)});}
 else if(cmd==='lint'){const r=lintVault(root); out(r); process.exitCode=r.ok?0:1;}
 else if(cmd==='ingest'){const content=val('--content'); const file=val('--file'); out(ingestSource({root,sourceId:val('--source'),content:content??(await import('node:fs')).readFileSync(file,'utf8'),metadata:{}}));}
 else if(cmd==='propose'){out(propose({root,proposalId:val('--id'),target:val('--target'),body:(await import('node:fs')).readFileSync(val('--body'),'utf8'),sourceIds:val('--source')?[val('--source')]:[]}));}
 else if(cmd==='approve'){out(approve({root,proposalId:args[1]}));}
 else if(cmd==='apply'){out(applyProposal({root,proposalId:args[1]}));}
 else if(cmd==='query'){out(query({root,query:args.slice(1).filter(x=>x!=='--json').join(' ')}));}
 else if(cmd==='migrate'){out((await import('../tools/kad/wiki/migration.mjs')).executeMigration({root,legacyRoot:path.resolve(val('--legacy-root')||'wiki')}));}
 else if(cmd==='rebuild'){out(rebuild(root));}
 else if(cmd==='context'){out(buildContextPack({root,query:val('--query')||args[1],task:val('--task')||''}));}
 else {out('Usage: kad-wiki status|lint|ingest|propose|approve|apply|query|rebuild|context|migrate'); process.exitCode=2;}
} catch(e){process.stderr.write(`kad-wiki: ${e.message}\n`); process.exitCode=1;}
