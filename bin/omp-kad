#!/usr/bin/env bash
set -euo pipefail

WORK_ROOT="${KAD_WORKSPACE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# ADR 0018: the newest mise-provided build is the harness. A bare `which omp` is not enough — a
# hand-installed copy earlier on PATH can silently shadow the mise build in every login shell. One
# such copy (`~/.local/bin/omp`, 18.1.14, 200 MB) did exactly that here and was removed on
# 2026-09-12; the resolution order stays as defence in depth, not because it is still needed.
resolve_omp_binary() {
  local resolved
  if command -v mise >/dev/null 2>&1; then
    resolved="$(mise which omp 2>/dev/null | head -n1 || true)"
    if [[ -n "$resolved" && -x "$resolved" ]]; then printf '%s' "$resolved"; return 0; fi
  fi
  resolved="$(command -v omp 2>/dev/null || true)"
  if [[ -n "$resolved" && -x "$resolved" ]]; then printf '%s' "$resolved"; return 0; fi
  printf '%s' "$WORK_ROOT/bin/omp-patched-canary"
}

# Two profiles share one state tree. The default is interactive; `--unattended` selects the bounded
# retry profile (ADR 0019): an interactive session may wait for a provider-stated usage reset because
# a human can abort it, an unattended run has nobody to abort it and must fail fast instead of
# sleeping through the window. The default profile keeps the state directory name `agent` so the
# existing session state stays where it is.
PROFILE="interactive"
STATE_DIR="agent"
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--unattended" ]]; then PROFILE="unattended"; STATE_DIR="unattended"; continue; fi
  ARGS+=("$arg")
done

OMP_BINARY="${OMP_BINARY:-$(resolve_omp_binary)}"
OMP_STATE="$WORK_ROOT/.state/omp-kad/$STATE_DIR"
OMP_PROFILE_CONFIG="$WORK_ROOT/config/omp-$PROFILE.yml"
MODEL_CONFIG="$WORK_ROOT/.omp/models.yml"
LINK="$OMP_STATE/models.yml"

if [[ ! -x "$OMP_BINARY" ]]; then
  printf 'omp-kad: missing or non-executable pinned binary: %s\n' "$OMP_BINARY" >&2
  exit 127
fi

# P03 qualification: strict digest enforcement when requested or testing patched canary
if [[ "${OMP_STRICT_DIGEST:-0}" == "1" || ("$OMP_BINARY" == *"-patched-canary" && "${OMP_SKIP_DIGEST_CHECK:-0}" != "1") ]]; then
  EXPECTED_DIGEST="${OMP_EXPECTED_DIGEST:-e0ff9cf2fc622d775597c970d6dcbba6b1ca93ea10c52ae2ad60b0ef9cc34ed3}"
  ACTUAL_DIGEST="$(sha256sum "$OMP_BINARY" | awk '{print $1}')"
  if [[ "$ACTUAL_DIGEST" != "$EXPECTED_DIGEST" ]]; then
    printf 'omp-kad: binary digest mismatch: expected %s, got %s\n' "$EXPECTED_DIGEST" "$ACTUAL_DIGEST" >&2
    exit 126
  fi
fi

if [[ ! -f "$MODEL_CONFIG" ]]; then
  printf 'omp-kad: missing tracked model configuration: %s\n' "$MODEL_CONFIG" >&2
  exit 78
fi

mkdir -p "$OMP_STATE" \
  "$WORK_ROOT/.state/omp-kad/xdg/data/omp" \
  "$WORK_ROOT/.state/omp-kad/xdg/state/omp" \
  "$WORK_ROOT/.state/omp-kad/xdg/cache/omp"

export XDG_DATA_HOME="$WORK_ROOT/.state/omp-kad/xdg/data"
export XDG_STATE_HOME="$WORK_ROOT/.state/omp-kad/xdg/state"
export XDG_CACHE_HOME="$WORK_ROOT/.state/omp-kad/xdg/cache"

# Link model definitions
ln -sf "$MODEL_CONFIG" "$LINK"

# Link user credentials so remote models and API keys remain functional in isolated state
SOURCE_AGENT_DIR="$HOME/.omp/agent"
SOURCE_XDG_DATA="$HOME/.local/share/omp"

if [[ -f "$SOURCE_AGENT_DIR/.env" ]]; then
  ln -sf "$SOURCE_AGENT_DIR/.env" "$OMP_STATE/.env"
  ln -sf "$SOURCE_AGENT_DIR/.env" "$WORK_ROOT/.state/omp-kad/xdg/data/omp/.env"
fi

if [[ -f "$SOURCE_XDG_DATA/agent.db" ]]; then
  ln -sf "$SOURCE_XDG_DATA/agent.db" "$WORK_ROOT/.state/omp-kad/xdg/data/omp/agent.db"
  ln -sf "$SOURCE_XDG_DATA/agent.db" "$OMP_STATE/agent.db"
elif [[ -f "$SOURCE_AGENT_DIR/agent.db" ]]; then
  ln -sf "$SOURCE_AGENT_DIR/agent.db" "$WORK_ROOT/.state/omp-kad/xdg/data/omp/agent.db"
  ln -sf "$SOURCE_AGENT_DIR/agent.db" "$OMP_STATE/agent.db"
fi

if [[ -f "$HOME/.deepapi/env" ]]; then
  # Sourced safely without mutating caller shell
  # shellcheck source=/dev/null
  source "$HOME/.deepapi/env"
fi

# The launcher redirects PI_CODING_AGENT_DIR into the workspace state tree, so the machine-global
# agent config is deliberately not read on KAD runs. That layer is where the operator's
# `retry.waitForUsageReset: true` lived, which meant KAD runs silently took the built-in default
# (`false`) and never waited out a provider-stated reset — see the ADR 0019 amendment. Each profile
# therefore declares its own agent-dir config in the repository, so the retry posture is a
# reviewable file instead of ambient machine state.
if [[ ! -f "$OMP_PROFILE_CONFIG" ]]; then
  printf 'omp-kad: missing profile config: %s\n' "$OMP_PROFILE_CONFIG" >&2
  exit 78
fi
ln -sf "$OMP_PROFILE_CONFIG" "$OMP_STATE/config.yml"

if [[ "$PROFILE" == "unattended" ]]; then
  printf 'omp-kad: unattended profile — retry.waitForUsageReset=false, fails fast instead of waiting for a usage reset\n' >&2
fi

export PI_CODING_AGENT_DIR="$OMP_STATE"

# P03: Never infer ownership of or delete $HOME/.omp.
exec "$OMP_BINARY" ${ARGS[@]+"${ARGS[@]}"}
